<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SJK Gold Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-100 font-sans text-slate-800 pb-12">

    <!-- Header -->
    <header class="bg-yellow-500 text-white shadow-md py-6 px-4 mb-8">
        <div class="max-w-5xl mx-auto flex items-center gap-3">
            <i class="fas fa-coins text-3xl"></i>
            <div>
                <h1 class="text-2xl font-bold">SJK Gold Tracker</h1>
                <p class="text-sm text-yellow-100">Pantau Tabungan dan Investasi Emasmu</p>
            </div>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Kiri: Input Harga & Form Pembelian -->
        <div class="md:col-span-1 space-y-6">
            
            <!-- Harga Emas Hari Ini -->
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-lg font-bold mb-3 text-slate-700">Harga Emas Hari Ini</h2>
                <div class="relative">
                    <span class="absolute left-3 top-3 text-slate-500">Rp</span>
                    <input type="number" id="currentPrice" placeholder="Harga per gram" class="w-full pl-10 pr-3 py-2 border rounded-lg focus:ring-2 focus:ring-yellow-400 outline-none transition" oninput="calculateAssets()">
                </div>
                <p class="text-xs text-slate-400 mt-2">*Update harga ini untuk melihat nilai asetmu saat ini.</p>
            </div>

            <!-- Form Pembelian -->
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-lg font-bold mb-4 text-slate-700">Catat Pembelian Baru</h2>
                <form id="purchaseForm" class="space-y-4">
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Tanggal Pembelian</label>
                        <input type="date" id="date" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-yellow-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Merk Emas (Antam, UBS, dll)</label>
                        <input type="text" id="brand" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-yellow-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Jumlah Gram</label>
                        <input type="number" step="0.01" id="grams" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-yellow-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Total Harga Beli (Rp)</label>
                        <input type="number" id="purchasePrice" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-yellow-400 outline-none">
                    </div>
                    <div>
                        <label class="block text-sm text-slate-600 mb-1">Tujuan Tabungan</label>
                        <select id="goal" required class="w-full px-3 py-2 border rounded-lg focus:ring-2 focus:ring-yellow-400 outline-none">
                            <option value="Dana Darurat">Dana Darurat</option>
                            <option value="Menikah">Menikah</option>
                            <option value="Pendidikan Anak">Pendidikan Anak</option>
                            <option value="Beli Rumah">Beli Rumah</option>
                            <option value="Beli Mobil">Beli Mobil</option>
                            <option value="Umroh">Umroh</option>
                            <option value="Liburan">Liburan</option>
                        </select>
                    </div>
                    <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 rounded-lg transition duration-200">
                        Simpan Data Emas
                    </button>
                </form>
            </div>
        </div>

        <!-- Kanan: Dashboard, Goals, & Histori -->
        <div class="md:col-span-2 space-y-6">
            
            <!-- Dashboard Total Aset -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 text-center">
                    <div class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-1">Total Gram</div>
                    <div class="text-xl font-bold text-slate-800" id="totalGrams">0g</div>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 text-center">
                    <div class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-1">Total Modal</div>
                    <div class="text-lg font-bold text-slate-800" id="totalInvestment">Rp 0</div>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border-b-4 border-yellow-400 text-center">
                    <div class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-1">Nilai Saat Ini</div>
                    <div class="text-lg font-bold text-yellow-600" id="currentValue">Rp 0</div>
                </div>
                <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 text-center relative overflow-hidden">
                    <div class="text-slate-500 text-xs font-bold uppercase tracking-wider mb-1">Total Profit</div>
                    <div class="text-lg font-bold" id="totalProfit">Rp 0</div>
                    <div class="text-xs font-bold mt-1" id="profitPercentage">0%</div>
                </div>
            </div>

            <!-- Progress Tujuan Keuangan -->
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-lg font-bold mb-4 text-slate-700">Progress Tujuan Keuangan</h2>
                <div id="goalsContainer" class="space-y-4">
                    <!-- Progress bar akan di-render di sini oleh JavaScript -->
                </div>
                <p class="text-xs text-slate-400 mt-4">*Target gramatur bisa diubah di dalam kode JavaScript (default: Menikah 50g, Rumah 200g, dll).</p>
            </div>

            <!-- Histori Pembelian -->
            <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 overflow-x-auto">
                <h2 class="text-lg font-bold mb-4 text-slate-700">Histori Pembelian</h2>
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 text-slate-500 text-sm border-b">
                            <th class="p-3 font-semibold">Tanggal</th>
                            <th class="p-3 font-semibold">Merk</th>
                            <th class="p-3 font-semibold">Tujuan</th>
                            <th class="p-3 font-semibold text-right">Gram</th>
                            <th class="p-3 font-semibold text-right">Harga Beli</th>
                        </tr>
                    </thead>
                    <tbody id="historyTable" class="text-sm text-slate-700">
                        <!-- Data histori akan di-render di sini -->
                    </tbody>
                </table>
            </div>

        </div>
    </main>

    <script>
        // Data penyimpanan sementara (di browser memory)
        let purchases = [];
        
        // Target Gram untuk masing-masing tujuan (Bisa kamu sesuaikan)
        const goalTargets = {
            'Dana Darurat': 20,
            'Menikah': 50,
            'Pendidikan Anak': 100,
            'Beli Rumah': 250,
            'Beli Mobil': 150,
            'Umroh': 60,
            'Liburan': 15
        };

        const formatRupiah = (angka) => {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
        };

        // Form Submit Handler
        document.getElementById('purchaseForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const newPurchase = {
                date: document.getElementById('date').value,
                brand: document.getElementById('brand').value,
                grams: parseFloat(document.getElementById('grams').value),
                price: parseFloat(document.getElementById('purchasePrice').value),
                goal: document.getElementById('goal').value
            };

            purchases.push(newPurchase);
            this.reset();
            updateUI();
        });

        // Fungsi Utama untuk Update Tampilan
        function updateUI() {
            calculateAssets();
            renderGoals();
            renderHistory();
        }

        // Fitur 3 & 4: Hitung Nilai & Aset
        function calculateAssets() {
            const currentPricePerGram = parseFloat(document.getElementById('currentPrice').value) || 0;
            
            let totalGrams = 0;
            let totalInvestment = 0;

            purchases.forEach(p => {
                totalGrams += p.grams;
                totalInvestment += p.price;
            });

            const currentValue = totalGrams * currentPricePerGram;
            const totalProfit = currentValue - totalInvestment;
            let profitPercentage = 0;
            
            if (totalInvestment > 0 && currentPricePerGram > 0) {
                profitPercentage = (totalProfit / totalInvestment) * 100;
            }

            // Update DOM
            document.getElementById('totalGrams').innerText = totalGrams.toFixed(2) + 'g';
            document.getElementById('totalInvestment').innerText = formatRupiah(totalInvestment);
            
            if (currentPricePerGram > 0) {
                document.getElementById('currentValue').innerText = formatRupiah(currentValue);
                document.getElementById('totalProfit').innerText = formatRupiah(totalProfit);
                
                const profitEl = document.getElementById('totalProfit');
                const percentEl = document.getElementById('profitPercentage');
                
                percentEl.innerText = profitPercentage.toFixed(2) + '%';

                if (totalProfit >= 0) {
                    profitEl.className = "text-lg font-bold text-green-600";
                    percentEl.className = "text-xs font-bold mt-1 text-green-600";
                } else {
                    profitEl.className = "text-lg font-bold text-red-600";
                    percentEl.className = "text-xs font-bold mt-1 text-red-600";
                }
            }
        }

        // Fitur 2: Render Progress Tujuan
        function renderGoals() {
            const container = document.getElementById('goalsContainer');
            container.innerHTML = '';

            // Hitung gram per tujuan
            const goalProgress = {};
            purchases.forEach(p => {
                if (!goalProgress[p.goal]) goalProgress[p.goal] = 0;
                goalProgress[p.goal] += p.grams;
            });

            // Tampilkan hanya tujuan yang sudah ada tabungannya
            for (const [goalName, currentGrams] of Object.entries(goalProgress)) {
                const target = goalTargets[goalName] || 100; // Default 100g jika tidak ada di list
                let percentage = (currentGrams / target) * 100;
                if (percentage > 100) percentage = 100;

                const html = `
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="font-semibold text-slate-700">${goalName}</span>
                            <span class="text-slate-500">${currentGrams.toFixed(2)}g / ${target}g (${percentage.toFixed(1)}%)</span>
                        </div>
                        <div class="w-full bg-slate-200 rounded-full h-2.5">
                            <div class="bg-yellow-400 h-2.5 rounded-full transition-all duration-500" style="width: ${percentage}%"></div>
                        </div>
                    </div>
                `;
                container.innerHTML += html;
            }

            if(Object.keys(goalProgress).length === 0) {
                container.innerHTML = '<p class="text-sm text-slate-400 italic">Belum ada data tujuan tabungan.</p>';
            }
        }

        // Fitur 1: Render Histori Pembelian
        function renderHistory() {
            const tbody = document.getElementById('historyTable');
            tbody.innerHTML = '';

            // Sort dari yang terbaru
            const sortedPurchases = [...purchases].reverse();

            sortedPurchases.forEach(p => {
                const tr = document.createElement('tr');
                tr.className = "border-b border-slate-100 hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="p-3">${p.date}</td>
                    <td class="p-3"><span class="bg-slate-200 text-slate-700 px-2 py-1 rounded text-xs font-semibold">${p.brand}</span></td>
                    <td class="p-3">${p.goal}</td>
                    <td class="p-3 text-right font-semibold">${p.grams}g</td>
                    <td class="p-3 text-right">${formatRupiah(p.price)}</td>
                `;
                tbody.appendChild(tr);
            });

            if(purchases.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-slate-400 text-sm italic">Belum ada transaksi pembelian emas.</td></tr>';
            }
        }

        // Inisialisasi awal
        updateUI();

    </script>
</body>
</html>
